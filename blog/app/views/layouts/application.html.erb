<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Pantry Pages | ET-718</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body>
  <header class="site-header"><div class="container header-inner">
    <%= link_to "PANTRY PAGES / ABDUL", root_path, class: "brand" %>
    <nav aria-label="Main navigation"><%= link_to "Explore", articles_path %><%= link_to "Add a post", new_article_path, class: "nav-button" %></nav>
  </div></header>
  <main class="container">
    <% if notice %><div class="flash notice" role="status"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert" role="alert"><%= alert %></div><% end %>
    <%= yield %>
  </main>
  <footer class="site-footer"><div class="container">Pantry Pages &middot; Abdul &middot; ET-718 Rails project &middot; Cloud9</div></footer>
</body>
</html>
