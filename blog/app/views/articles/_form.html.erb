<%= form_with model: article, class: "editor-form" do |form| %>
  <% if article.errors.any? %><div class="form-errors"><strong>Please fix:</strong><ul><% article.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="field"><%= form.label :title, "Post title" %><%= form.text_field :title, required: true, maxlength: 160 %></div>
  <div class="field"><%= form.label :meal, "Meal" %><%= form.select :meal, Article::MEALS, { prompt: "Choose one" }, { required: true } %></div>
  <div class="field"><%= form.label :prep_minutes, "Total minutes" %><%= form.number_field :prep_minutes, min: 1, max: 600, required: true %></div>
<div class="field"><%= form.label :difficulty, "Difficulty" %><%= form.select :difficulty, Article::DIFFICULTIES, { prompt: "Choose difficulty" }, { required: true } %></div>
<div class="field"><%= form.label :ingredients, "Ingredients (one per line)" %><%= form.text_area :ingredients, rows: 6, required: true %></div>
  <div class="field"><%= form.label :body, "Your writing" %><%= form.text_area :body, rows: 12, required: true %></div>
  <div class="form-actions"><%= form.submit (article.persisted? ? "Save changes" : "Publish post"), class: "button button-primary" %><%= link_to "Cancel", articles_path, class: "button button-outline" %></div>
<% end %>
