<section class="hero"><div class="hero-copy"><span class="eyebrow">RECIPES, NOTES & EVERYDAY COOKING</span><h1>Good food.<br>Good stories.<br><em>Made to share.</em></h1><p>A practical kitchen journal for small experiments and favorite meals.</p><%= link_to "Write a new post →", new_article_path, class: "button button-primary" %></div><div class="hero-aside" aria-hidden="true"><div><span>12</span><small>FRESH IDEAS</small></div></div></section>
<section class="list-heading"><div><span class="eyebrow">FROM THE KITCHEN</span><h2>Recipes to try</h2></div><span class="counter"><%= pluralize(@quick_count, "recipe") %> under 30 minutes</span></section>
<%= link_to (@quick_only ? "✓ Quick meals only — clear" : "⚡ Show meals in 30 minutes or less"), articles_path(meal: @selected, quick: (@quick_only ? nil : "1")), class: "quick-toggle" %><div class="filter-pills">
  <%= link_to "All", articles_path(quick: (@quick_only ? "1" : nil)), class: (@selected.blank? ? "pill active" : "pill") %>
  <% Article::MEALS.each do |value| %>
    <%= link_to value, articles_path(meal: value, quick: (@quick_only ? "1" : nil)), class: (@selected == value ? "pill active" : "pill") %>
  <% end %>
</div>
<div class="article-grid"><%= render partial: "card", collection: @articles, as: :article %></div>
<% if @articles.empty? %><div class="empty-state">No posts here yet. Choose another filter or write a new one.</div><% end %>
